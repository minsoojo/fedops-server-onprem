# All values are examples, not a verified F environment.
TARGET_NAMESPACE=fedops
FEDOPS_SERVER_MANAGER_URL=http://manager.example.invalid:8000
FEDOPS_CLIENT_PERFORMANCE_URL=http://performance.example.invalid:8001
WEB_BACKEND_SERVER=http://web.example.invalid:4000
FEDOPS_HOSTPATH_STORAGE_NODE=REPLACE_WITH_F_NODE
FEDOPS_TASK_STORAGE_BASE_PATH=/data/fedops/fedops/tasks
FEDOPS_TASK_STORAGE_CAPACITY=20Gi
FL_SERVER_PORT_MIN=40026
FL_SERVER_PORT_MAX=40039
FEDOPS_ISTIO_VIRTUAL_SERVICE=fedops-virtualservice
FEDOPS_ISTIO_GATEWAY=istio-system/istio-ingressgateway
FEDOPS_ISTIO_HOST=fedops.svc.cluster.local
# Set a verified image/digest before deployment; existing default image is unchanged.
FEDOPS_TASK_IMAGE=docker.io/tpah20/torch_cpu_amd:latest
# Reference name only. Never put task access keys into the Manager's generated plain env.
FEDOPS_TASK_S3_SECRET_NAME=s3secret
REGION_NAME=ap-northeast-2
# S3_ENDPOINT_URL and S3_FORCE_PATH_STYLE are optional; keep unset until trigger review.
